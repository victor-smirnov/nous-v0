// hot.dl — the higher-order layer, and where it comes apart from the low-level one.
//
// Included by reasoner.dl. HOT is treated as a theory of the *succession of conscious states* rather than as a
// rival account of consciousness, so nothing here competes with the bootstrap: the bootstrap says which states
// are operative, this says which of them the subject has a higher-order representation of. The interesting
// quantity is the difference.
//
// Edges are second-order facts over fact refs, which spec v3 R3 already permits — a thought about a thought and
// a fact about a fact have the same shape, so no new representation was needed.
//
// One asymmetry to keep in view: the edges are neutral-field vocabulary and are read whatever `--theory` says,
// but the inventory of low-level states comes from the bootstrap and is therefore gated. Under `--theory off`
// the graph is still built; only the states it is compared against disappear.

.decl hot_edge(s:symbol, kind:symbol, target:symbol, lv:number)
hot_edge(S, "aware",   T, Lv) :- rf(F, S, "hot_aware",   T), usable(F, Lv).
hot_edge(S, "becomes", T, Lv) :- rf(F, S, "hot_becomes", T), usable(F, Lv).
hot_edge(S, "takes",   T, Lv) :- rf(F, S, "hot_takes",   T), usable(F, Lv).
hot_edge(S, "wonders", T, Lv) :- rf(F, S, "hot_wonders", T), usable(F, Lv).
.output hot_edge

.decl hot_blind_edge(s:symbol, target:symbol, lv:number)
hot_blind_edge(S, T, Lv) :- rf(F, S, "hot_blind", T), usable(F, Lv).
.output hot_blind_edge

// A fact reference concerns the entities the referenced fact relates: that is how an edge over a fact reaches
// the low-level state the case states about an entity.
.decl about(t:symbol, e:symbol)
about(T, L) :- fact(T, L, _, _, _, _, _, _, _, _), !ref(L).
about(T, R) :- fact(T, _, _, _, R, _, _, _, _, _), !ref(R).

.decl represented(s:symbol, e:symbol)
represented(S, E) :- hot_edge(S, _, T, _), about(T, E).
represented(S, E) :- hot_edge(S, _, E, _), !ref(E).

.decl noticed_absent(s:symbol, e:symbol)                 // the text asserts the failure outright
noticed_absent(S, E) :- hot_blind_edge(S, T, _), about(T, E).
noticed_absent(S, E) :- hot_blind_edge(S, E, _), !ref(E).

// ------------------------------------------------------------------ the inventory this is compared against
// What the case says is operative in the system, whether or not anything represents it.
.decl low_state(s:symbol, e:symbol, kind:symbol)
low_state(S, X, "stimulus")    :- stimulus(X, S, _).
low_state(S, N, "active need") :- active_need(N, S, _, _).
.output low_state

// The relation this layer exists for: operative, and with no higher-order representation in the subject.
.decl unconscious_determinant(s:symbol, e:symbol, kind:symbol)
unconscious_determinant(S, E, K) :- low_state(S, E, K), !represented(S, E).
.output unconscious_determinant

// Asserted blindness that the case does not back with an operative state — an encoding slip rather than a
// finding, so it is worth surfacing separately.
.decl blind_without_state(s:symbol, e:symbol)
blind_without_state(S, E) :- noticed_absent(S, E), !low_state(S, E, _).
.output blind_without_state

// ------------------------------------------------------------------ awareness is per fact, not per entity
// Forced by the material rather than designed: a subject can be aware that a thing is present and not aware of
// what it costs him. Those are two facts about one entity, so entity-level coverage above cannot tell them
// apart — it reports the entity as represented on the strength of either. The relations below keep the
// distinction the text makes.
.decl represented_fact(s:symbol, f:symbol)
represented_fact(S, T) :- hot_edge(S, _, T, _), ref(T).
.decl unnoticed_fact_edge(s:symbol, f:symbol)
unnoticed_fact_edge(S, T) :- hot_blind_edge(S, T, _), ref(T).

.decl low_fact(s:symbol, f:symbol, kind:symbol)          // the facts that state an operative low-level relation
low_fact(S, F, "stimulus")    :- rf(F, _, "stimulus_in", S), usable(F, _).
low_fact(S, F, "active need") :- rf(F, _, "active_in", S), usable(F, _).
low_fact(S, F, "what it costs") :- fact(F, X, _, _, _, _, _, _, _, U), sem(U, "delta"), usable(F, _), stimulus(X, S, _).
.output low_fact

.decl unconscious_fact(s:symbol, f:symbol, kind:symbol)
unconscious_fact(S, F, K) :- low_fact(S, F, K), !represented_fact(S, F).
.output unconscious_fact

.decl fact_asymmetry(observer:symbol, subject:symbol, covered:number, total:number)
fact_asymmetry(O, S, C, T) :- hot_edge(O, _, _, _), low_fact(S, _, _),
                              C = count : { low_fact(S, F, _), represented_fact(O, F) },
                              T = count : { low_fact(S, _, _) }.
.output fact_asymmetry

// ------------------------------------------------------------------ whose edges reach whose states
// The point of the exercise: two subjects, one set of operative states. An external reader has higher-order
// representations of determinants the subject inside the system has none of. Same states, different coverage —
// which is the asymmetry the low-level layer alone cannot express, and the reason the two layers are separate.
.decl covers(observer:symbol, subject:symbol, e:symbol)
covers(O, S, E) :- low_state(S, E, _), represented(O, E).

.decl hot_asymmetry(observer:symbol, subject:symbol, covered:number, total:number)
hot_asymmetry(O, S, C, T) :- hot_edge(O, _, _, _), low_state(S, _, _),
                             C = count : { covers(O, S, _) }, T = count : { low_state(S, _, _) }.
.output hot_asymmetry

.decl hot_stat(s:symbol, k:symbol, n:number)
hot_stat(S, "low-level states", C)          :- low_state(S, _, _), C = count : { low_state(S, _, _) }.
hot_stat(S, "with a higher-order edge", C)  :- low_state(S, _, _), C = count : { low_state(S, X, _), represented(S, X) }.
hot_stat(S, "unnoticed", C)                 :- low_state(S, _, _), C = count : { unconscious_determinant(S, _, _) }.
hot_stat(S, "unnoticed, said so by the text", C) :- low_state(S, _, _), C = count : { noticed_absent(S, _) }.
hot_stat(S, "higher-order edges", C)        :- hot_edge(S, _, _, _), C = count : { hot_edge(S, _, _, _) }.
.output hot_stat

// ------------------------------------------------------------------ the protopathic layer
// Awareness is graded and the boundary is blurred, but in a language where everything is explicit "hidden"
// cannot mean "not represented". It can only mean *nameless*: a quantity whose contributors were summed over
// and whose keys never reached the head of the rule. That is a lossy projection, irreversible by construction,
// and it is what "behind the tokens" amounts to in a black box — except that here both sides are visible.
//
// So the split is: the signals an observer has a higher-order representation of keep their key (the frame);
// the rest enter only through aggregates keyed by observer and subject alone (the tail). Head's three marks of
// the protopathic — intensity, crude valence, poor localisation — are three statistics that survive the
// projection: total weight, sign balance, spread. Nothing in this stratum joins the tail on the signal's key.
//
// The signal space is the stimulus × need pairs, where emotional_signal lives; a signal is represented only if
// its own cost fact is. Being aware that a stimulus is present says nothing about what it costs.
.decl signal_fact(s:symbol, f:symbol, m:float)
signal_fact(S, F, M) :- fact(F, X, _, _, N, _, _, _, _, U), sem(U, "delta"), usable(F, _),
                        emotional_signal(S, X, N, M, _).

.decl frame(o:symbol, s:symbol, f:symbol, m:float)          // keyed: the observer can say which
frame(O, S, F, M) :- signal_fact(S, F, M), represented_fact(O, F).
.decl tail(o:symbol, s:symbol, f:symbol, m:float)           // the analyst sees this; the observer sees only proto
tail(O, S, F, M) :- signal_fact(S, F, M), hot_edge(O, _, _, _), !represented_fact(O, F).
.output frame
.output tail

.decl tail_abs(o:symbol, s:symbol, f:symbol, a:float)
tail_abs(O, S, F, A) :- tail(O, S, F, M), A = max(M, 0.0 - M).
.decl frame_abs(o:symbol, s:symbol, f:symbol, a:float)
frame_abs(O, S, F, A) :- frame(O, S, F, M), A = max(M, 0.0 - M).

.decl tail_intensity(o:symbol, s:symbol, i:float)
tail_intensity(O, S, I) :- tail(O, S, _, _), I = sum A : { tail_abs(O, S, _, A) }.
.decl tail_share_sq(o:symbol, s:symbol, f:symbol, q:float)
tail_share_sq(O, S, F, Q) :- tail_abs(O, S, F, A), tail_intensity(O, S, I), P = A / I, Q = P * P.

.decl proto(o:symbol, s:symbol, k:symbol, v:float)          // what the observer has of the tail: no keys
proto(O, S, "intensity", V)      :- tail_intensity(O, S, V).
proto(O, S, "valence", V)        :- tail(O, S, _, _), V = sum M : { tail(O, S, _, M) }.
proto(O, S, "count", V)          :- tail(O, S, _, _), C = count : { tail(O, S, _, _) }, V = to_float(C).
proto(O, S, "mean weight", V)    :- tail_intensity(O, S, I), proto(O, S, "count", C), V = I / C.
proto(O, S, "spread", V)         :- tail_intensity(O, S, _), Q = sum X : { tail_share_sq(O, S, _, X) }, V = 1.0 - Q.
.output proto

.decl frame_stat(o:symbol, s:symbol, k:symbol, v:float)
frame_stat(O, S, "intensity", V)   :- frame(O, S, _, _), V = sum A : { frame_abs(O, S, _, A) }.
frame_stat(O, S, "count", V)       :- frame(O, S, _, _), C = count : { frame(O, S, _, _) }, V = to_float(C).
frame_stat(O, S, "mean weight", V) :- frame_stat(O, S, "intensity", I), frame_stat(O, S, "count", C), V = I / C.
frame_stat(O, S, "mean weight", 0.0) :- tail(O, S, _, _), !frame(O, S, _, _).
.output frame_stat

// The share of the subject's operative weight that reaches the observer only as mass, never as a name.
.decl nameless_share(o:symbol, s:symbol, v:float)
nameless_share(O, S, V) :- proto(O, S, "intensity", T), frame_stat(O, S, "intensity", F), V = T / (T + F).
nameless_share(O, S, 1.0) :- proto(O, S, "intensity", _), !frame(O, S, _, _).
.output nameless_share

// Displacement. A full frame is not the same as a well-placed one: the budget can be spent on the light
// signals while the heavy ones stay in the tail. Two conditions, so that neither alone carries it — the
// heaviest signal in the subject has no name for this observer, and the tail outweighs the frame per signal.
.decl signal_abs(s:symbol, f:symbol, a:float)
signal_abs(S, F, A) :- signal_fact(S, F, M), A = max(M, 0.0 - M).
.decl heaviest(s:symbol, f:symbol)
heaviest(S, F) :- signal_abs(S, F, A), A = max X : { signal_abs(S, _, X) }.
.decl displacement(o:symbol, s:symbol)
displacement(O, S) :- heaviest(S, F), tail(O, S, F, _),
                      proto(O, S, "mean weight", T), frame_stat(O, S, "mean weight", W), T > W.
.output displacement

// ------------------------------------------------------------------ succession
// A batch evaluation has no time of its own. The text lends it one: positions are stated, and the order of
// reading is the order of the states.
.decl hot_position(e:symbol, p:number, lv:number)
hot_position(E, P, Lv) :- fact(F, E, _, _, _, V, _, _, _, U), sem(U, "hot_at"), usable(F, Lv), V != "",
                          P = to_number(V).
.output hot_position

.decl later(a:symbol, b:symbol)
later(A, B) :- hot_position(A, PA, _), hot_position(B, PB, _), PA < PB.
.decl has_between(a:symbol, b:symbol)
has_between(A, B) :- later(A, C), later(C, B).
.decl succeeds(a:symbol, b:symbol)                       // immediate succession in the read
succeeds(A, B) :- later(A, B), !has_between(A, B).
.output succeeds
