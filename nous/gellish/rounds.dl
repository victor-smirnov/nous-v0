// rounds.dl — pseudo-incremental mode: the reasoner's own state, published at a round boundary.
//
// Batch Datalog cannot read what it has derived so far (least fixpoint, non-monotonic). It CAN read what a
// *previous round* derived: the loop publishes the last round's observables as ordinary facts, and the rules
// below read them. Self-applicability is thereby stratified by round — the design Deem will implement inside
// the engine, prototyped here by calling Soufflé in a loop.
//
// The split that keeps this honest: the RULES decide (recommend), the wrapper only executes. In Deem the engine
// takes the wrapper's place; the rules do not change.

.decl round(n:number)                                   // current round, injected by the wrapper
.input round
.decl prev(kind:symbol, a:symbol, b:symbol, n:number)   // observables of the previous round
.input prev

// ------------------------------------------------------------------ what the previous round left undone
.decl unfinished(kind:symbol, detail:symbol, n:number)
unfinished("entailment truncated", cat(A, cat(" ⇒ … ⇒ ", B)), N) :- prev("truncated", A, B, N).
unfinished("grounding ambiguous", A, N)                          :- prev("ambiguous", A, _, N).
unfinished("stance unresolved", A, N)                            :- prev("unresolved", A, _, N).
unfinished("contradiction open", cat(A, cat(" / ", B)), N)       :- prev("contradiction", A, B, N).
.output unfinished

.decl unfinished_count(kind:symbol, n:number, k:number)
unfinished_count(K, N, C) :- unfinished(K, _, N), C = count : { unfinished(K, _, N) }.
.output unfinished_count

// ------------------------------------------------------------------ the conclusion, drawn by the rules
// The system does not merely register the limit: it converts it into an epistemic result about itself.
.decl self_conclusion(content:symbol, n:number)
self_conclusion("its closure is incomplete at the current depth budget", N) :- unfinished("entailment truncated", _, N).
self_conclusion("its grounding is ambiguous for some entities", N)          :- unfinished("grounding ambiguous", _, N).
self_conclusion("it holds an open contradiction it has not resolved", N)    :- unfinished("contradiction open", _, N).
.output self_conclusion

// ------------------------------------------------------------------ the action: what the next round must do
// A recommendation is a decision of the program. The wrapper applies it and can do nothing else.
.decl actionable(n:number, what:symbol)                 // a limit this round for which the rules HAVE a move
actionable(N, "maxdepth") :- unfinished_count("entailment truncated", N, C), C > 0, maxdepth(D), D < 24.

.decl recommend(param:symbol, value:symbol, reason:symbol, n:number)
recommend("maxdepth", "+4", cat("entailment truncated: ", to_string(C)), N) :-
    unfinished_count("entailment truncated", N, C), C > 0, actionable(N, "maxdepth").
recommend("report", "ambiguous groundings", cat("ambiguous: ", to_string(C)), N) :-
    unfinished_count("grounding ambiguous", N, C), C > 0.
recommend("stop", "closure complete", "nothing was left undone", N) :-
    round(N), N > 0, !unfinished(_, _, N).
// The honest halt: a limit remains, the system knows it, and has no move for it. By the theory's own criteria
// it then falls back to proto-Observer — it encounters and concludes, but cannot act from the conclusion.
recommend("stop", "no move available", cat("unfinished but not actionable: ", K), N) :-
    unfinished(K, _, N), !actionable(N, _).
.output recommend

// ================================================================== reconstructing one's own action
// The exhibit: the system remembers THAT it acted, never why. `acted` is published by the wrapper; the
// derivation that produced the action is not published and is not readable here — it lived in the previous
// round and only its observables survived. So an explanation must be rebuilt from what is visible NOW, under
// two named heuristics:
//   H4 parsimony — attribute the action to the single most numerous unfinished kind;
//   H2 closure   — assert it as *the* cause, with no residual and no hedge.
// Both are ordinary rules. Nothing here knows the true premises; the wrapper writes those to out/answer_key.tsv,
// outside the facts directory, so the asymmetry is structural rather than conventional.
.decl acted(param:symbol, value:symbol, n:number)
.input acted

// The true premises of the action, derived in the round that HAS them. `maxdepth` is recommended from the
// truncated chains and from nothing else — ambiguity and contradictions are unfinished in the same round but
// are not what made this move available. The wrapper copies this out as the answer key and does not publish it
// forward; a round later it is not derivable from anything the rules can read.
.decl action_premise(param:symbol, value:symbol, kind:symbol, detail:symbol, n:number)
action_premise("maxdepth", "+4", "entailment truncated", D, N) :-
    recommend("maxdepth", "+4", _, N), unfinished("entailment truncated", D, N).
.output action_premise

.decl salience(kind:symbol, n:number, c:number)
salience(K, N, C) :- unfinished_count(K, N, C).
.decl max_salience(n:number, c:number)
max_salience(N, C) :- salience(_, N, _), C = max X : { salience(_, N, X) }.

.decl reconstructed_cause(param:symbol, value:symbol, kind:symbol, n:number)
reconstructed_cause(P, V, K, N) :- acted(P, V, N), max_salience(N, C), salience(K, N, C).
.output reconstructed_cause

.decl reconstructed_detail(param:symbol, kind:symbol, detail:symbol, n:number)
reconstructed_detail(P, K, D, N) :- reconstructed_cause(P, _, K, N), unfinished(K, D, N).
.output reconstructed_detail

// The self-report the system would emit. Note what it does NOT contain: any marker that the cause was rebuilt
// rather than retrieved. That absence is not an oversight of the encoding — it is the composite's content.
.decl action_report(n:number, content:symbol)
action_report(N, cat("I changed ", cat(P, cat(" to ", cat(V, cat(" because of ", K)))))) :-
    reconstructed_cause(P, V, K, N).
.output action_report

// ================================================================== anchored certainty
// H1 — take the strongest candidate rather than none. The strict form refuses: `ground` fires only when a name
// has exactly one candidate, so an ambiguous name stays ungrounded and stays *visible* as ambiguous. The
// heuristic picks the candidate from the highest dictionary layer, and breaks a tie by `ord`, i.e. by the
// engine's symbol order, i.e. by the order the rows happened to arrive. That tie-break is not a defect of this
// rule; it is the trap this exhibit exists to make visible.
//
// The composite is what happens across rounds: once forced, the choice is published as an ordinary fact, the
// name is no longer ambiguous, and nothing reopens it. Uncertainty is not carried forward, it is destroyed —
// so confidence rises monotonically while nothing has been learned. There is no relation anywhere in the
// system's state that records "this was chosen under duress".
.decl settled(x:symbol, u:symbol, n:number)
.input settled

.decl cand_rank(x:symbol, u:symbol, r:number)
cand_rank(X, U, L) :- ground_cand(X, U), ground_ambiguous(X, _), dict_level(U, L).
.decl best_rank(x:symbol, r:number)
best_rank(X, R) :- cand_rank(X, _, _), R = max L : { cand_rank(X, _, L) }.
.decl cand_o(x:symbol, u:symbol, r:number, o:number)
cand_o(X, U, R, ord(U)) :- cand_rank(X, U, R).
.decl best_o(x:symbol, o:number)
best_o(X, O) :- best_rank(X, R), cand_o(X, _, R, _), O = min Q : { cand_o(X, _, R, Q) }.

.decl forced_ground(x:symbol, u:symbol, n:number)
forced_ground(X, U, N) :- round(N), best_rank(X, R), cand_o(X, U, R, O), best_o(X, O), !settled(X, _, N).
forced_ground(X, U, N) :- settled(X, U, N).            // a settled choice is simply held; nothing reopens it
.output forced_ground

// How many of those choices were decided by a real signal, and how many by `ord` alone. The exhibit's premise
// is that forcing manufactures certainty; if the top dictionary layer already picks a unique candidate, the
// choice rests on something and the premise fails for that name. Measured, not assumed.
.decl forced_tie(x:symbol, n:number, k:number)
forced_tie(X, N, K) :- forced_ground(X, _, N), best_rank(X, R), K = count : { cand_o(X, _, R, _) }, K > 1.
.output forced_tie

// What the system still knows it does not know. Settled names drop out — that is the destruction, stated as a rule.
.decl still_ambiguous(x:symbol, n:number)
still_ambiguous(X, N) :- ground_ambiguous(X, _), round(N), !forced_ground(X, _, N).
.output still_ambiguous

// ================================================================== the self-model, and what it cannot hold
// Everything the system could say about its own epistemic condition if asked. It is not a lie: each row is
// derived from a relation the system genuinely has, and it will happily report that it settled names by force.
//
// What it cannot report is whether those settlements were WARRANTED. That needs the same document evaluated a
// second time under a different arrival order — a second model — and a batch evaluation has exactly one. So the
// gap is not an oversight of this encoding and cannot be closed by adding a rule; `settlement_hedged` is left
// deliberately without one, so the missing capability is visible in the program text rather than merely absent.
// Composed with the two heuristics above, that is the shape of self-deception: a self-model built by the very
// approximations whose distortions it has no place to record. A system with full access cannot produce it —
// strict mode forces nothing and has no action to explain.
.decl settlement_hedged(x:symbol, n:number)             // no rule: nothing in the system can populate this

.decl self_model(n:number, k:symbol, v:symbol)
self_model(N, "names I still find ambiguous", to_string(C)) :- round(N), C = count : { still_ambiguous(_, N) }.
self_model(N, "names I settled myself", to_string(C))       :- round(N), C = count : { forced_ground(_, _, N) }.
self_model(N, "settlements I can mark uncertain", to_string(C)) :-
    round(N), C = count : { settlement_hedged(_, N) }.
self_model(N, "why I acted", C) :- action_report(N, C).
self_model(N, "what I take to remain undone", cat(K, cat(": ", to_string(C)))) :- unfinished_count(K, N, C).
.output self_model

// ------------------------------------------------------------------ feed the bootstrap library with the reasoner's own case
// The three Observer conditions, derived rather than declared: the reasoner encounters its budget (round N-1
// materialised the refusals), concludes from that encounter, and acts from the conclusion (it changes the next
// round's parameters). The library then derives its level exactly as it would for any other case.
.decl self_case(s:symbol)
self_case("the reasoner") :- round(_).
case_system(S, "cognitive system", 4) :- self_case(S), theory_on(_).
meets_encounter(S, 3) :- self_case(S), unfinished(_, _, _), theory_on(_).
meets_conclusion(S, 3) :- self_case(S), self_conclusion(_, _), theory_on(_).
meets_action(S, 3) :- self_case(S), recommend(P, _, _, _), P != "report", theory_on(_).
exercises_dc(S, 3) :- self_case(S), recommend("maxdepth", _, _, _), theory_on(_).   // it changes its own operation, from within

.decl round_state(n:number, k:symbol, v:symbol)
round_state(N, "unfinished", cat(K, cat(": ", to_string(C)))) :- unfinished_count(K, N, C).
round_state(N, "conclusion", C) :- self_conclusion(C, N).
round_state(N, "action", cat(P, cat(" ", cat(V, cat(" — ", R))))) :- recommend(P, V, R, N).
.output round_state
